# Local development credentials for compose.yaml.
# Copy to .env and replace every value. Never commit .env.
# These are for your machine only; cloud credentials live in Kubernetes Secrets.

LOG_LEVEL=debug
IMAGE_TAG=main

POSTGRES_PASSWORD=change-me-postgres

# One migration role (owns the schema) and one runtime role per service database.
IDENTITY_MIGRATOR_PASSWORD=change-me-identity-migrator
IDENTITY_APP_PASSWORD=change-me-identity-app
ACCESS_MIGRATOR_PASSWORD=change-me-access-migrator
ACCESS_APP_PASSWORD=change-me-access-app
WORKFLOW_MIGRATOR_PASSWORD=change-me-workflow-migrator
WORKFLOW_APP_PASSWORD=change-me-workflow-app
INVENTORY_MIGRATOR_PASSWORD=change-me-inventory-migrator
INVENTORY_APP_PASSWORD=change-me-inventory-app
PRODUCTION_MIGRATOR_PASSWORD=change-me-production-migrator
PRODUCTION_APP_PASSWORD=change-me-production-app

RABBITMQ_ADMIN_PASSWORD=change-me-rabbitmq-admin
# One RabbitMQ user per service.
IDENTITY_MQ_PASSWORD=change-me-identity-mq
ACCESS_MQ_PASSWORD=change-me-access-mq
WORKFLOW_MQ_PASSWORD=change-me-workflow-mq
INVENTORY_MQ_PASSWORD=change-me-inventory-mq
PRODUCTION_MQ_PASSWORD=change-me-production-mq
